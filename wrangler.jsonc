{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amas-stop-and-scan",
  "compatibility_date": "2026-06-01",
  // Static site: each route is pre-rendered HTML. Unknown paths fall back to 404.html.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
