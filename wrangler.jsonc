{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stopscan",
  "compatibility_date": "2026-06-01",
  // Static-assets Worker: serves the built Vite SPA from /dist.
  // No server-side script needed — this is an assets-only Worker.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
