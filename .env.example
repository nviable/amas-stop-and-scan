# Get your key from https://stitch.withgoogle.com → Settings → API key
STITCH_API_KEY=your-key-here

# Canonical site URL for sitemap.xml (no trailing slash)
VITE_SITE_URL=https://amas-stop-and-scan.workers.dev

# Optional CDN/R2 prefix for static assets (no trailing slash). Leave unset to serve from /public.
# VITE_ASSET_BASE_URL=https://assets.example.com
